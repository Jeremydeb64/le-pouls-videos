 "dialogue": [
  {
   "qui": "lucie",
   "texte": "Les feux d'artifice bruyants vont-ils disparaître ? Salut, c'est Lucie, et aujourd'hui, la votation du 29 novembre, dans 17 jours."
  },
  {
   "qui": "arthur",
   "texte": "C'est une initiative : un texte lancé par des citoyens. Il veut interdire la vente et l'usage des feux d'artifice bruyants pour les particuliers."
  },
  {
   "qui": "lucie",
   "texte": "Les feux de Bengale et les volcans resteraient permis."
  },
  {
   "qui": "arthur",
   "texte": "Le camp du oui réunit des associations de protection des animaux. Pour elles, les détonations paniquent les bêtes. Elles pointent aussi 1300 tonnes de déchets par an."
  },
  {
   "qui": "lucie",
   "texte": "Le camp du non réunit le Conseil fédéral, la majorité du Parlement et des milieux économiques. Pour eux, l'initiative va trop loin : les règles existent déjà. Ils défendent aussi la tradition, et craignent pour les emplois du secteur."
  },
  {
   "qui": "arthur",
   "texte": "En Valais, Val de Bagnes et Nendaz ne tireront rien à la Saint-Sylvestre : sécheresse, et respect après le drame de Crans-Montana. Pas de lien avec l'initiative. Bagnes en rediscutera après le vote."
  },
  {
   "qui": "lucie",
   "texte": "Si le oui l'emporte, les particuliers ne pourront plus tirer de pièces bruyantes."
  },
  {
   "qui": "arthur",
   "texte": "Si c'est non, les règles actuelles restent."
  },
  {
   "qui": "lucie",
   "texte": "À retenir : vote le 29 novembre. Il vise les feux bruyants des particuliers."
  },
  {
   "qui": "arthur",
   "texte": "Un camp défend les animaux, l'autre la tradition et les emplois."
  },
  {
   "qui": "lucie",
   "texte": "C'était Lucie…"
  },
  {
   "qui": "arthur",
   "texte": "…et Arthur, pour Le Pouls."
  },
  {
   "qui": "lucie",
   "texte": "On se retrouve demain."
  }
 ],
